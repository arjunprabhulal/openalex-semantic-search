# Copy to .env and adjust. Never commit a real key; .env is git-ignored.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPENALEX_SEARCH_INDEX=/var/lib/openalex-semantic-search/generations/10k
OPENALEX_SEARCH_API_KEYS=replace-with-a-random-application-key
OPENALEX_SEARCH_HOST=127.0.0.1
OPENALEX_SEARCH_PORT=8100

# Runtime model. The benchmark records the actual backend and throughput.
OPENALEX_SEARCH_MODEL=BAAI/bge-small-en-v1.5
OPENALEX_SEARCH_DEVICE=cpu
OPENALEX_SEARCH_MODEL_CACHE=/var/lib/openalex-semantic-search/cache/huggingface

# Read-time search tuning (openalex_semantic_search/config.py SearchTuning). Unset means
# the generation manifest's value, i.e. no change. Tune with
# benchmark/tune_search.py before setting any of these.
# OPENALEX_SEARCH_NPROBE=192
# OPENALEX_SEARCH_CANDIDATES=1000
# OPENALEX_SEARCH_FILTER_NPROBE=768
# OPENALEX_SEARCH_FILTER_CANDIDATES=2000
# OPENALEX_SEARCH_EXACT_FILTER_ROWS=10000
# OPENALEX_SEARCH_RERANK_WINDOW=40
